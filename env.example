# Sample environment configuration for the CI Triage Agent.
# Copy to ".env" and fill in real values. Never commit the real .env.

# Optional: enables the real LLM-backed fix suggestions.
# When unset or empty, the agent automatically falls back to a deterministic
# mock client, so the project runs fully offline without any credentials.
OPENAI_API_KEY=

# Optional: override the default model used when OPENAI_API_KEY is set.
# CI_TRIAGE_MODEL=gpt-4o
